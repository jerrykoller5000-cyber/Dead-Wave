# Local HTTP server output from "Play Dead-Wave.bat"
server.log
server-error.log

# Scratch files (syntax-check helpers both agents use)
.tmp-*
.syntax*
.chk.mjs

# Local-only
__pycache__/
.claude/settings.local.json
index.dev.html
Claude outputs/
Commit and Push.bat
Claude Commit.bat
# Jerry's Suno originals (WAV, ~550 MB). The game plays the mp3s made from them.
assets/soundtrack/incoming/*.wav

# One page per test run (tools/tests/run-all.mjs): a killed run can leave one behind
tools/tests/test*.html

# The shipped copy and the desktop shell's build output (tools/package.mjs, desktop/)
dist/
desktop/node_modules/
desktop/src-tauri/target/

# The camera's inbox (tools/CAMERA.md) and Claude's launcher for it
review/camera/jobs/
Claude Camera.bat

# CL-163: ElevenLabs music takes while Jerry picks them (45 tracks x up to 4 takes, hundreds of MB).
# The picked ones go into the game as their own files; the prompts, guides and receipts here stay tracked.
z-music/**/*.mp3

# Leftovers from "Tidy up Tiny Trek.bat" and a crashed shell (CL-202)
_DELETE ME/
bash.exe.stackdump

# D-94: files made from Jerry's paid sound packs (F:\Sound_Effects): the licences allow them in the game but not on a
# server, so they stay on his PC and ship only inside the builds (docs/audio/packs.md).
z-sounds/**/pk-*
z-sounds/index-packs.json
# D-97 (Claude, 2026-10-29): the 1.2 score is made from Jerry's Ghosthack packs (F:\Music); their licence forbids a public server,
# so the files made from them live on his PC and in the builds only.
assets/soundtrack/**/gh-*
