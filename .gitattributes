# Normalise line endings on commit; .bat files must be CRLF on checkout or cmd.exe
# can mis-read labels (Play Dead-Wave.bat uses goto :defaultbrowser).
* text=auto
*.bat text eol=crlf

*.mp3 binary
*.png binary
*.jpg binary
*.woff2 binary

# Vendored third-party code is stored byte-exact: it is never edited here, and letting
# git rewrite its line endings would show a 1.7 MB library as changed on every platform.
vendor/** -text
