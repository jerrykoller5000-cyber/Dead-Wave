{"cmd":"eval","timeout":180000,"code":"R.release();if(!T.trainingDbg.state().active){document.getElementById('playerName').value='Door review';document.getElementById('modeTraining').click();}for(let i=0;i<600&&(!T.trainingDbg.state().active||document.getElementById('trainingBlackout')?.classList.contains('on'));i++)await wait(100);if(!T.trainingDbg.lights().on)T.trainingDbg.toggleLights();T.trainingDbg.clear();return {active:T.trainingDbg.state().active,position:T.player.position.toArray()};"}