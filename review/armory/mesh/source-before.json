"// GP-125: a full-size issue cabinet. The original interaction point stays under its left-hand sign;\r\n      // the extra rack space extends toward the middle of the HQ wall (and downrange in Training).\r\n      {\r\n        const arm = new THREE.Group(); arm.name = 'hq-armory'; arm.position.set(W + 0.02, 0, HQ_ARMORY_Z); arm.rotation.y = Math.PI / 2; g.add(arm);\r\n        const back = new THREE.MeshStandardMaterial({ color: 0x333e40, roughness: 0.88, metalness: 0.15, emissive: 0x162023, emissiveIntensity: 0.22 });\r\n        const rail = new THREE.MeshStandardMaterial({ color: 0x737d79, roughness: 0.6, metalness: 0.45 });\r\n        // Stand clear of the HQ wall piers; no world geometry or approach coordinates move.\r\n        box(4.12, 3.02, 0.08, back, 0.76, 2.28, 0.32, arm);\r\n        box(4.26, 0.16, 0.54, steelDark, 0.76, 3.86, 0.51, arm);\r\n        box(4.26, 0.12, 0.6, steelDark, 0.76, 0.78, 0.51, arm);\r\n        box(4.16, 0.055, 0.035, hazard, 0.76, 0.82, 0.825, arm);\r\n        for (const sx of [-1.31, 2.83]) box(0.12, 3.02, 0.54, steelDark, sx, 2.30, 0.51, arm);\r\n        for (const y of [1.04, 2.10, 3.02, 3.48]) box(4.0, 0.045, 0.035, rail, 0.76, y, 0.385, arm);\r\n        // A shallow lip separates the pistol/SMG hooks from the upright long-gun cradles.\r\n        box(4.0, 0.035, 0.12, steelDark, 0.76, 2.99, 0.42, arm);\r\n        const strip = new THREE.MeshBasicMaterial({ color: 0xb8d0c7 });\r\n        box(3.82, 0.035, 0.055, strip, 0.76, 3.745, 0.55, arm);\r\n        const rack = new THREE.Group(); rack.name = 'armoryRack'; arm.add(rack);\r\n        house.armoryRack = rack;\r\n        const cv = document.createElement('canvas'); cv.width = 256; cv.height = 96;\r\n        const c2 = cv.getContext ? cv.getContext('2d') : null;\r\n        if (c2) {\r\n          c2.fillStyle = '#1d2126'; c2.fillRect(0, 0, 256, 96);\r\n          c2.fillStyle = '#e3b62b'; c2.textAlign = 'center'; c2.textBaseline = 'middle';\r\n          c2.font = 'bold 50px Impact, \"Arial Black\", sans-serif'; c2.fillText(dwText('armory.title').toUpperCase(), 128, 48);\r\n        }\r\n        const signTex = new THREE.CanvasTexture(cv);\r\n        if (THREE.SRGBColorSpace) signTex.colorSpace = THREE.SRGBColorSpace;\r\n        const sign = new THREE.Mesh(new THREE.PlaneGeometry(1.44, 0.54),\r\n          new THREE.MeshStandardMaterial({ map: signTex, emissiveMap: signTex, emissive: 0xffffff, emissiveIntensity: 0.45, roughness: 0.6 }));\r\n        sign.position.set(0, 4.19, 0.49); arm.add(sign);\r\n        house.lockSigns.push(sign.material);\r\n      }\r\n      "