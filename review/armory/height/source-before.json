"// GP-125: a full-size issue cabinet. GP-126 adds a wall collar and mesh service screen;\r\n      // the centered sign and opening share the cabinet axis. Approach coordinates remain unchanged.\r\n      {\r\n        const arm = new THREE.Group(); arm.name = 'hq-armory'; arm.position.set(W + 0.02, 0, HQ_ARMORY_Z); arm.rotation.y = Math.PI / 2; g.add(arm);\r\n        const back = new THREE.MeshStandardMaterial({ color: 0x333e40, roughness: 0.88, metalness: 0.15, emissive: 0x162023, emissiveIntensity: 0.22 });\r\n        const rail = new THREE.MeshStandardMaterial({ color: 0x737d79, roughness: 0.6, metalness: 0.45 });\r\n        // Stand clear of the HQ wall piers; no world geometry or approach coordinates move.\r\n        box(4.12, 3.02, 0.08, back, 0.76, 2.28, 0.32, arm);\r\n        box(4.26, 0.16, 0.54, steelDark, 0.76, 3.86, 0.51, arm);\r\n        box(4.26, 0.12, 0.6, steelDark, 0.76, 0.78, 0.51, arm);\r\n        box(4.16, 0.055, 0.035, hazard, 0.76, 0.82, 0.825, arm);\r\n        for (const sx of [-1.31, 2.83]) box(0.12, 3.02, 0.54, steelDark, sx, 2.30, 0.51, arm);\r\n        for (const y of [1.04, 2.10, 3.02, 3.48]) box(4.0, 0.045, 0.035, rail, 0.76, y, 0.385, arm);\r\n        // A shallow lip separates the pistol/SMG hooks from the upright long-gun cradles.\r\n        box(4.0, 0.035, 0.12, steelDark, 0.76, 2.99, 0.42, arm);\r\n        const strip = new THREE.MeshBasicMaterial({ color: 0xb8d0c7 });\r\n        box(3.82, 0.035, 0.055, strip, 0.76, 3.745, 0.55, arm);\r\n        // A bolted steel reveal closes the gap to the wall, with a matching sign plinth and lower apron.\r\n        // All framing is one static draw, and the expanded-metal screen is another.\r\n        const casing = new THREE.MeshStandardMaterial({ color: 0x50585c, roughness: 0.8, metalness: 0.35 });\r\n        const frameParts = [];\r\n        const frame = (w, h, d, x, y, z) => {\r\n          const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), casing);\r\n          m.position.set(x, y, z); frameParts.push(m);\r\n        };\r\n        for (const x of [-1.39, 2.91]) frame(0.20, 3.48, 0.90, x, 2.20, 0.42);\r\n        frame(4.50, 0.20, 0.90, 0.76, 3.91, 0.42);\r\n        frame(4.50, 0.34, 0.90, 0.76, 0.60, 0.42);\r\n        frame(1.72, 0.64, 0.22, 0.76, 4.23, 0.64);\r\n        // A clear central hatch through the mesh, with a narrow counter below it.\r\n        for (const x of [0.18, 1.34]) frame(0.07, 0.86, 0.09, x, 2.30, 0.90);\r\n        for (const y of [1.905, 2.695]) frame(1.23, 0.07, 0.09, 0.76, y, 0.90);\r\n        frame(1.30, 0.07, 0.26, 0.76, 1.88, 0.97);\r\n        const surround = mergeParts(frameParts, casing, { castShadow: false, receiveShadow: true });\r\n        surround.name = 'armory-wall-surround'; arm.add(surround);\r\n        // Clipped diagonal strips form real holes; the small hatch is entirely open, not painted black.\r\n        const meshVertices = [], zMesh = 0.865;\r\n        const wire = (x0, y0, x1, y1) => {\r\n          const len = Math.hypot(x1 - x0, y1 - y0); if (len < 0.001) return;\r\n          const dx = -(y1 - y0) / len * 0.005, dy = (x1 - x0) / len * 0.005;\r\n          const a = [x0 + dx, y0 + dy, zMesh], b = [x0 - dx, y0 - dy, zMesh];\r\n          const c = [x1 - dx, y1 - dy, zMesh], d = [x1 + dx, y1 + dy, zMesh];\r\n          meshVertices.push(...a, ...b, ...c, ...a, ...c, ...d);\r\n        };\r\n        for (const [left, right, bottom, top] of [[-1.25, 0.18, 0.86, 3.76], [1.34, 2.77, 0.86, 3.76], [0.18, 1.34, 0.86, 1.905], [0.18, 1.34, 2.695, 3.76]]) {\r\n          for (const slope of [-1, 1]) for (let c = -5; c <= 7; c += 0.14) {\r\n            // y = slope*x + c, clipped to this panel rectangle.\r\n            const xa = Math.max(left, slope > 0 ? bottom - c : c - top);\r\n            const xb = Math.min(right, slope > 0 ? top - c : c - bottom);\r\n            if (xb > xa) wire(xa, slope * xa + c, xb, slope * xb + c);\r\n          }\r\n        }\r\n        const screenGeo = new THREE.BufferGeometry();\r\n        screenGeo.setAttribute('position', new THREE.Float32BufferAttribute(meshVertices, 3)); screenGeo.computeVertexNormals();\r\n        const screen = new THREE.Mesh(screenGeo, new THREE.MeshStandardMaterial({ color: 0x68726e, roughness: 0.65, metalness: 0.5, side: THREE.DoubleSide }));\r\n        screen.name = 'armory-security-mesh'; screen.raycast = rackNoRay; arm.add(screen);\r\n        // Anchor heads read as a wall-mounted frame without adding one draw per bolt.\r\n        const boltPoints = [];\r\n        for (const x of [-1.39, 2.91]) for (const y of [0.64, 1.25, 2.3, 3.3, 3.91]) boltPoints.push([x, y, 0.89]);\r\n        for (const x of [-0.75, 0.76, 2.27]) for (const y of [0.60, 3.91]) boltPoints.push([x, y, 0.89]);\r\n        const bolts = new THREE.InstancedMesh(new THREE.CylinderGeometry(0.027, 0.027, 0.018, 6), rail, boltPoints.length);\r\n        const boltPose = new THREE.Object3D(); boltPose.rotation.x = Math.PI / 2;\r\n        boltPoints.forEach(([x, y, z], i) => { boltPose.position.set(x, y, z); boltPose.updateMatrix(); bolts.setMatrixAt(i, boltPose.matrix); });\r\n        bolts.name = 'armory-frame-bolts'; arm.add(bolts);\r\n        const rack = new THREE.Group(); rack.name = 'armoryRack'; arm.add(rack);\r\n        house.armoryRack = rack;\r\n        const cv = document.createElement('canvas'); cv.width = 256; cv.height = 96;\r\n        const c2 = cv.getContext ? cv.getContext('2d') : null;\r\n        if (c2) {\r\n          c2.fillStyle = '#1d2126'; c2.fillRect(0, 0, 256, 96);\r\n          c2.fillStyle = '#e3b62b'; c2.textAlign = 'center'; c2.textBaseline = 'middle';\r\n          c2.font = 'bold 50px Impact, \"Arial Black\", sans-serif'; c2.fillText(dwText('armory.title').toUpperCase(), 128, 48);\r\n        }\r\n        const signTex = new THREE.CanvasTexture(cv);\r\n        if (THREE.SRGBColorSpace) signTex.colorSpace = THREE.SRGBColorSpace;\r\n        const sign = new THREE.Mesh(new THREE.PlaneGeometry(1.44, 0.54),\r\n          new THREE.MeshStandardMaterial({ map: signTex, emissiveMap: signTex, emissive: 0xffffff, emissiveIntensity: 0.45, roughness: 0.6 }));\r\n        sign.name = 'armory-sign'; sign.position.set(0.76, 4.23, 0.765); arm.add(sign);\r\n        house.lockSigns.push(sign.material);\r\n      }\r\n      "