#rangeConsole[hidden],#rangeDrillHud[hidden]{display:none!important}
#rangeConsole{position:fixed;inset:0;z-index:1150;display:grid;place-items:center;background:#050a09c7;color:#dedeca;font:14px/1.45 system-ui,sans-serif;padding:22px}
#rangeConsole .rd-panel{width:min(1100px,96vw);max-height:92vh;overflow:auto;background:#141c19;border:1px solid #a29a55;border-top:4px solid #ddc947;box-shadow:0 18px 80px #000b;padding:24px}
#rangeConsole header{display:flex;align-items:center;justify-content:space-between;gap:20px}#rangeConsole h2{font-size:24px;margin:4px 0;color:#ddc947;letter-spacing:1px}#rangeConsole h3{margin:8px 0;color:#e6dda8}#rangeConsole p{margin:9px 0}
#rangeConsole button{font:inherit;color:inherit;background:#25342d;border:1px solid #576a50;padding:10px 14px;cursor:pointer;text-align:left}#rangeConsole button:hover,#rangeConsole button:focus-visible{background:#3b4d3c;outline:2px solid #d2c149;outline-offset:1px}#rangeConsole button:disabled{cursor:default;opacity:.45}#rangeConsole .selected>button:first-child,#rangeConsole nav .selected{border-color:#e3ca49;background:#3c4527}
#rangeConsole .rd-layout{display:grid;grid-template-columns:185px 1fr;gap:20px;margin-top:16px}#rangeConsole nav{display:flex;flex-direction:column;gap:5px}#rangeConsole nav button{display:flex;justify-content:space-between}#rangeConsole main{display:grid;grid-template-columns:1fr 1fr;gap:20px}#rangeConsole .rd-drills{display:flex;flex-direction:column;gap:10px}#rangeConsole .range-card{display:grid;grid-template-columns:1fr}#rangeConsole .range-card b,#rangeConsole .range-card span{display:block}#rangeConsole .range-card span{margin-top:5px;font-size:13px;color:#bec5b6}#rangeConsole .rd-board-button{font-size:11px;text-align:right;padding:3px 10px;color:#bfc89f;background:#1a261f}#rangeConsole .rd-details{padding:0 12px;border-left:1px solid #526146}
.rd-dim{color:#a9b3a0;font-size:12px}.rd-rules{padding:12px;background:#2a2d1c;border-left:3px solid #d1bc43}.rd-error{color:#ff8370!important}.rd-records ol{padding-left:24px;margin:10px 0}.rd-records li{padding:6px;border-bottom:1px solid #364335}.rd-records li span,.rd-records li time{margin-left:12px;font-size:12px}.rd-big{font-size:62px;color:#e3cd4c;font-weight:900}.rd-result{max-width:650px!important}.rd-result footer{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
#rangeDrillHud{position:fixed;z-index:80;top:85px;left:50%;transform:translateX(-50%);width:390px;max-width:45vw;padding:14px 20px;background:#111b18ee;border:1px solid #b7a44d;border-top:3px solid #ebd23d;color:#e9e8d4;text-align:center;pointer-events:none;font:13px/1.4 system-ui,sans-serif}#rangeDrillHud strong,#rangeDrillHud small{display:block}#rangeDrillHud strong{color:#e9d14b;letter-spacing:1px}#rangeDrillHud .rd-count{font-size:68px;line-height:1.2;color:#ffe263}#rangeDrillHud .rd-numbers{display:flex;justify-content:space-between;margin-top:10px}#rangeDrillHud p{margin:6px 0}.rd-call{font-size:16px}
@media(max-width:850px){#rangeConsole main{grid-template-columns:1fr}#rangeConsole .rd-details{border-left:0;border-top:1px solid #526146;padding-top:14px}#rangeConsole .rd-layout{grid-template-columns:145px 1fr}#rangeDrillHud{max-width:65vw}}
#rangeDrillHud{left:16px;top:310px;transform:none;width:255px;max-width:30vw;text-align:left;padding:12px 14px}
#rangeDrillHud.rd-countdown{left:50%;top:100px;transform:translateX(-50%);width:300px;text-align:center;max-width:50vw}

/* Timed drills have their own score and clear counter; the practice banner is unrelated. */
body:has(#rangeDrillHud:not([hidden])) #trainingHud{display:none}
/* GP-19912: browse first, understand the sequence, then explicitly start. */
.rd-path{display:flex;gap:12px;align-items:center;padding:10px 0 18px;color:#d6d8bb}.rd-path span{border:1px solid #697459;padding:5px 12px;background:#26342b}.rd-path i{font-style:normal;color:#bda84b}
#rangeConsole main{grid-template-columns:minmax(250px,.8fr) minmax(350px,1.3fr);align-items:start;gap:22px}
#rangeConsole .range-card{display:flex;gap:13px;width:100%;align-items:flex-start;padding:13px;border:1px solid #47584b;background:#1a2821}
#rangeConsole .range-card.selected{border-color:#e1cd63;background:#35412b;box-shadow:inset 4px 0 #e1cd63}
.range-card small,.range-card b,.range-card span span{display:block}.range-card small,.rd-level{font-size:10px;color:#c5bc75;text-transform:uppercase;letter-spacing:.08em}.range-card b{font-size:15px;margin:3px 0 6px}.range-card span span{font-size:12px;color:#becaba}
.rd-number{font:700 24px/1 monospace;color:#e1cd63;padding-top:5px}.rd-steps{padding-left:25px}.rd-steps li{padding:6px 0 6px 5px}.rd-facts{display:flex;gap:8px;flex-wrap:wrap;font-size:12px}.rd-facts span{background:#26382e;border:1px solid #526349;padding:5px 8px}
#rangeConsole .rd-start{width:100%;margin-top:16px;text-align:center;font-weight:800;background:#c9b759;color:#111a14;border:1px solid #efdf84}
.rd-best-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:8px;margin:12px 0}.rd-best-grid div{background:#0f1b15;border:1px solid #495944;padding:10px}.rd-best-grid small{display:block;font-size:10px;min-height:30px;color:#b3c1a9}.rd-best-grid b{display:block;font:700 23px monospace;color:#dfd181}
#rangeConsole .rd-metric-tabs{display:flex;gap:5px;flex-wrap:wrap}#rangeConsole .rd-metric-tabs button{font-size:10px;padding:6px 8px}#rangeConsole .rd-metric-tabs [aria-pressed=true]{background:#465334;border-color:#dac75e}
.rd-history{padding-left:22px}.rd-history li{display:grid;grid-template-columns:1fr 1fr;gap:4px;font-size:11px}.rd-history time{grid-column:1/-1;color:#9ba995}.rd-result-metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px;background:#0c1711}.rd-best-announcement{color:#e5d574}
#rangeDrillHud.rd-countdown{left:16px;top:310px;transform:none;width:255px;max-width:30vw;text-align:left}.rd-empty{padding:14px;background:#102019;color:#bfcdb9}
@media(max-width:1050px){#rangeConsole main{grid-template-columns:1fr}.rd-drills{display:grid!important;grid-template-columns:1fr 1fr}#rangeConsole .rd-layout{grid-template-columns:160px 1fr}.rd-details{border-left:0!important;padding-left:0!important}}
@media(max-width:650px){#rangeConsole{padding:8px}#rangeConsole .rd-panel{padding:14px}#rangeConsole .rd-layout{grid-template-columns:1fr}#rangeConsole nav{display:grid;grid-template-columns:repeat(3,1fr)}.rd-best-grid{grid-template-columns:1fr}.rd-best-grid small{min-height:0}.rd-drills{grid-template-columns:1fr}}
