"      // --- CU-61: the CIF on the south face, west of the mural, mirroring the start panel: a\r\n      // hatch with uniforms on a rail inside and a stencilled plate over it.\r\n      {\r\n        const cif = new THREE.Group(); cif.name = 'hq-cif'; cif.position.set(W + 0.02, 0, HQ_CIF_Z); cif.rotation.y = Math.PI / 2; g.add(cif);   // CL-103: the east face\r\n        box(1.22, 1.14, 0.02, new THREE.MeshStandardMaterial({ color: 0x0b0c0e, roughness: 1 }), 0, 1.65, 0.03, cif);   // the dark back\r\n        box(1.5, 0.16, 0.3, steelDark, 0, 2.3, 0.05, cif);                                   // lintel\r\n        box(1.5, 0.14, 0.42, hazard, 0, 1.02, 0.12, cif);                                    // counter\r\n        for (const sx of [-0.68, 0.68]) box(0.14, 1.42, 0.3, steelDark, sx, 1.63, 0.05, cif);\r\n        box(1.1, 0.03, 0.03, steel, 0, 2.12, 0.07, cif);                                     // hanging rail\r\n        for (const [i, col] of [0x5f6c3b, 0xc2a67a, 0x8e8f88, 0x6c7550, 0xb09a74].entries()) {\r\n          const x = -0.44 + i * 0.22;\r\n          box(0.17, 0.44, 0.04, new THREE.MeshStandardMaterial({ color: col, roughness: 0.95 }), x, 1.84, 0.07, cif);\r\n          box(0.02, 0.1, 0.02, steel, x, 2.07, 0.07, cif);\r\n        }\r\n        const cv = document.createElement('canvas'); cv.width = 256; cv.height = 96;\r\n        const c2 = cv.getContext ? cv.getContext('2d') : null;\r\n        if (c2) {\r\n          c2.fillStyle = '#1d2126'; c2.fillRect(0, 0, 256, 96);\r\n          c2.fillStyle = '#e3b62b'; c2.textAlign = 'center'; c2.textBaseline = 'middle';\r\n          c2.font = 'bold 56px Impact, \"Arial Black\", sans-serif'; c2.fillText(dwText('cif.title'), 128, 40);\r\n          c2.font = 'bold 15px Arial, sans-serif'; c2.fillText(dwText('cif.subtitle').toUpperCase(), 128, 80);\r\n        }\r\n        const signTex = new THREE.CanvasTexture(cv);\r\n        if (THREE.SRGBColorSpace) signTex.colorSpace = THREE.SRGBColorSpace;\r\n        const sign = new THREE.Mesh(new THREE.PlaneGeometry(1.44, 0.54),\r\n          new THREE.MeshStandardMaterial({ map: signTex, emissiveMap: signTex, emissive: 0xffffff, emissiveIntensity: 0.45, roughness: 0.6 }));\r\n        sign.position.set(0, 2.68, 0.06); cif.add(sign);\r\n        house.lockSigns = [sign.material];   // CU-82: tinted red at night\r\n      }\r\n"